# =============================================================================
# Luciel Frontend — environment template (SAFE to commit)
# =============================================================================
# Next.js reads env files only from apps/web: copy the NEXT_PUBLIC_* lines to
# apps/web/.env.local. The widget build reads VITE_WIDGET_* from the shell
# environment (Vite does not load them from a .env file here), so export them
# before `pnpm --filter @luciel/widget build`.
#
# HARD RULE: no secrets in any bundle, and no secret may live in a
# NEXT_PUBLIC_* variable. Anything prefixed NEXT_PUBLIC_ is inlined into the
# client bundle and is therefore PUBLIC. Only non-secret, already-public values
# may use that prefix.
#
# The session JWT is NEVER an env var here — it is carried by an httpOnly,
# Secure, SameSite cookie set by the backend, or held in memory only. It is
# never read from localStorage/sessionStorage.
# -----------------------------------------------------------------------------

# --- The ONE adapter-selection flag (api-client) -----------------------------
# "mock" -> in-memory mockAdapter (no backend). "http" -> real httpAdapter.
# Swapping mock->http must require ZERO component changes. Unset, a dev server
# uses "mock" and a production build uses "http".
NEXT_PUBLIC_API_ADAPTER=mock

# Public API origin used by the httpAdapter (NOT a secret — it is a public URL).
# Required only when NEXT_PUBLIC_API_ADAPTER=http.
NEXT_PUBLIC_API_BASE_URL=https://api.vantagemind.ai

# Public hCaptcha SITE key for the contact form (a public value; the hCaptcha
# secret lives only on the backend). Empty uses hCaptcha's documented test key.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Optional: the mock adapter's default scenario for this build (unset means
# "verified"). A browser can still pick another one at runtime with
# ?mock_scenario=<name>. Leave it commented out rather than empty. Accepted:
# verified, unverified, fresh, expired_session, at_cap, payg, paused, grace,
# closed, closed_window_passed, escalation_sms, knowledge_states.
# NEXT_PUBLIC_MOCK_SCENARIO=verified

# --- Widget build (apps/widget; export in the shell) -------------------------
# The widget's data-plane API origin. The embed key is NOT configured here —
# it is injected at runtime by the host page's data-key attribute.
VITE_WIDGET_API_BASE_URL=https://api.vantagemind.ai
VITE_WIDGET_ADAPTER=mock
