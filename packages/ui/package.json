{
  "name": "@luciel/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared, accessible UI primitives (Radix + Tailwind, token-backed). WCAG-AA behavior comes from Radix; we don't override it away (Space Instructions \u00a72, \u00a75).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder \u2014 eslint config added with first feature PR)\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@luciel/design-tokens": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^24.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  }
}
