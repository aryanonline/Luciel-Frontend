{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // The package's own code gets no Node or Vitest globals: it runs in the browser (the
    // widget bundle and the dashboard) and reads no process.env (see factory.ts). The tests
    // are checked by tsconfig.test.json, and `typecheck` runs both.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__", "src/**/*.test.ts"]
}
