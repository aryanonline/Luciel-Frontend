{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Node's types are for widget-bundle-imports.test.ts, which reads the sources through
    // node:fs, node:path and node:url. Vitest 4's own types no longer bring them along.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"]
}
