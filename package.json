{
  "name": "luciel-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "VantageMind (Luciel) customer-facing frontend — three artifacts (marketing, admin dashboard, embeddable widget) sharing a design system, never an auth context.",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @luciel/web test:e2e",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch@>=10.0.0 <11.0.1": "^11.0.8",
      "brace-expansion@1": "^1.1.22",
      "brace-expansion@2": "^2.1.8",
      "brace-expansion@>=3 <6": "^5.0.13",
      "browserslist": "^4.28.7",
      "glob@10": "^10.5.0",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.18",
      "vite": "^6.4.4"
    }
  }
}
